# --- Serveur ---
PORT=5000
MONGO_URI=mongodb://localhost:27017/cv-craft

# --- Authentification JWT ---
# ⚠️ SECRET COMPROMIS DANS L'HISTORIQUE GIT → SECRET ROTATION REQUIRED.
# Générer un NOUVEAU secret : openssl rand -hex 64
JWT_SECRET=change_me

# --- IA (Google Gemini) ---
GEMINI_API_KEY=change_me

# --- E-mails (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=example@example.com
EMAIL_PASS=change_me

# --- URLs ---
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Reverse proxy ---
# Nombre de sauts de reverse proxy à faire confiance pour le client IP
# (ex: 1 derrière nginx). Laisser vide si le serveur est exposé directement.
TRUST_PROXY=
