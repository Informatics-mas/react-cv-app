# --- Mock de paiement (Lot 2G) — EXEMPLE SANS SECRET — jamais de vraie clé ici ---
# DÉSACTIVÉ par défaut : variables absentes => paiements payants refusés (503),
# plan gratuit inchangé. Aucune clé GeniusPay n'est requise ni utilisée par le mock.

# Prestataire actif : none (défaut) | mock (TEST UNIQUEMENT) | geniuspay (futur, non implémenté)
PAYMENT_PROVIDER=none

# 2e signal obligatoire pour activer le mock (jamais une seule variable suffisante).
PAYMENT_MOCK_ENABLED=true

# Contexte de test explicite : dev (scénarios développeur/admin) | sandbox (parcours utilisateur)
PAYMENT_MOCK_ENV=dev

# --- Verrouillage production (Lot 2G.4A.1) — fail-closed ---
# Le mock n'est accepté que si UN signal POSITIF d'environnement non-productif
# est présent : NODE_ENV ou APP_ENV doit explicitement valoir l'une des valeurs
# development | dev | test | sandbox. Toute autre valeur (ou absence) = REFUS.
# NODE_ENV=production et APP_ENV=production refusent le mock SANS EXCEPTION.
# Le nom de la base n'est jamais le signal de sécurité (une production Neon
# nommée 'neondb' sans signal non-productif est refusée au démarrage).
NODE_ENV=development
# APP_ENV=test        # optionnel — alternative/supplément à NODE_ENV

