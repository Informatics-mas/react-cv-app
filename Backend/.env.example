# --- Serveur ---
PORT=5000

# --- Authentification JWT ---
# ⚠️ SECRET COMPROMIS DANS L'HISTORIQUE GIT → SECRET ROTATION REQUIRED.
# Générer un NOUVEAU secret : openssl rand -hex 64
JWT_SECRET=change_me

# --- IA (Google Gemini) ---
GEMINI_API_KEY=change_me

# --- E-mails (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=example@example.com
EMAIL_PASS=change_me

# --- URLs ---
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Base de données (PostgreSQL / Neon — UNIQUE) ---
# DATABASE_DRIVER : "postgres" (ou absent). Toute autre valeur (mongo…) est REFUSÉE.
# DATABASE_DRIVER=postgres
# Chaîne de connexion PostgreSQL (Neon) — OBLIGATOIRE.
# Réservée au backend : jamais exposée au frontend, jamais commitée.
# ⚠️ NE JAMAIS CONFONDRE URL de TEST et URL de PRODUCTION :
#   - TEST : base/branche jetable dédiée (ex. cvc_n2_final sur la branche migration-test) ;
#   - PRODUCTION : projet Neon de production — jamais utilisé depuis un poste de test.
# Format Neon : postgresql://<role>:[PASSWORD]@ep-XXXX.neon.tech/<base>?sslmode=require
# (TLS strict maintenu côté Node : rejectUnauthorized: true)
# DATABASE_URL=
# PGSSL=require

# --- Cookie d'authentification (Phase 3b) ---
# Domaine du cookie httpOnly. Laisser vide en développement (localhost).
# En production, OBLIGATOIRE si front et back partagent un même domaine
# enregistrable (ex: .exemple.com pour api.exemple.com + app.exemple.com) —
# sans quoi le middleware Next.js ne pourra pas lire le cookie.
# COOKIE_DOMAIN=.exemple.com

# --- Reverse proxy ---
# Nombre de sauts de reverse proxy à faire confiance pour le client IP
# (ex: 1 derrière nginx). Laisser vide si le serveur est exposé directement.
TRUST_PROXY=
