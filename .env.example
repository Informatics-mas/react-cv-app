# Frontend (Next.js) — variables exposées au navigateur (préfixe NEXT_PUBLIC_)
# Développement local :
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Production : remplacer par l'URL du backend déployé (jamais localhost).
# NEXT_PUBLIC_API_URL=https://ton-backend-domaine.com/api

# Phase 3b — Vérification JWT côté middleware Next.js (Edge).
# STRICTEMENT identique à Backend/.env (JWT_SECRET) — jamais préfixé NEXT_PUBLIC_
# (ce secret ne doit JAMAIS être exposé au navigateur).
# En production : définir aussi cette variable dans les settings Vercel
# (elle est inlinée au build du middleware).
JWT_SECRET=change_me
